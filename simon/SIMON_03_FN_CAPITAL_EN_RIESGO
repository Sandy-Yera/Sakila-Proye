CREATE OR REPLACE FUNCTION FN_CAPITAL_EN_RIESGO
    /*  
    A QUE PROBLEMA RESPONDE? 
     Sakila no sabe cuanto dinero debe gastar en todas las copias que nunca volvieron
    Que dicen los datos?
        Al corte hay 183 arriendos sin devolver, pero 182 estan dentro del plazo
        Solo 1 copia esta vencida. Con un costo de reposicion de 20,99 USD.
    Supuestos
        Para determinar el capital, lo hacemos utilizando la fecha de corte
    Hallazgo:
    H9 y correcion de la P1 sobre copias fugadas.
    IE2.1.3 e IE2.1.4
    */
RETURN NUMBER
IS
    V_MONTO_EN_RIESGO NUMBER;
    V_FECHA_CORTE DATE:= FN_FECHA_CORTE;
BEGIN
    -- Determina el capital que se debe dedicar para reponer
    -- todas las copias vencidas
    SELECT 
        NVL(SUM(F.REPLACEMENT_COST), 0)
    INTO V_MONTO_EN_RIESGO
    FROM RENTAL R
    JOIN INVENTORY I ON I.INVENTORY_ID = R.INVENTORY_ID
    JOIN FILM F ON F.FILM_ID = I.FILM_ID
    WHERE R.RETURN_DATE IS NULL
        AND TRUNC(V_FECHA_CORTE) - TRUNC(R.RENTAL_DATE) > F.RENTAL_DURATION;
        
    RETURN V_MONTO_EN_RIESGO;
END FN_CAPITAL_EN_RIESGO;
